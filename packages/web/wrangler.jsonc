{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmsn-llc",
  "main": "./+server.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cmsn-llc-media"
    }
  ],
  "preview_urls": true,
  "previews": {
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "cmsn-llc-media"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  }
}
