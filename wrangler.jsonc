{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmsn-llc",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "previews": {},
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  }
}
